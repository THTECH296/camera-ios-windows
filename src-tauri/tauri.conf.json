{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Câmera",
  "mainBinaryName": "camera",
  "version": "1.0.0",
  "identifier": "br.com.camera.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Câmera",
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 460,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
